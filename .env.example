# Zuper API Configuration
# Copy this file to .env and fill in your values

# Your Zuper API key (required)
ZUPER_API_KEY=your_api_key_here

# Base URL for Zuper API (optional, defaults to US region)
# Format: https://{region}.zuperpro.com/api
# Regions: us, eu, ap (Asia Pacific)
# ZUPER_BASE_URL=https://us.zuperpro.com/api
