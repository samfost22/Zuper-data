# --- Zuper (READ-ONLY) ---
# This service only GETs job details. It never PATCH/PUT/POSTs to Zuper.
ZUPER_BASE_URL=https://us-east-1.zuperpro.com
ZUPER_API_KEY=

# Webhook shared secret(s). Comma-separated allowed. ALL whitespace is stripped
# before compare (headers: x-webhook-secret OR secret-key / Secret-Key).
ZUPER_WEBHOOK_SECRET=

# Event codes to accept from payload.event (comma-separated).
# Zuper UI uses human labels (Module=Jobs, Event like "Update Job Status" /
# "Job Status Changed"); the JSON payload.event may be the code form below.
# Receiver accepts whatever is in this allowlist as-is (no UI-label mapping).
# WOP filtering still happens after GET on current job status, not event name.
# Missing/null event is not skipped on the allowlist — still GET + WOP filter.
# Confirm the exact event string shown in the Zuper UI when creating the
# webhook and add it here if it differs — do not rely on a guessed name.
ZUPER_EVENT_ALLOWLIST=job.status_changed,job.updated,job.update,job.update_status,job.status_update,job.update_schedule,job.created,job.create

# Optional: override the status string matched case-insensitively.
WOP_STATUS_NAME=Waiting on Parts

# Module SKU prefixes (comma-separated). Matches sku, item_sku, product_id,
# and nested product.product_id. Only identifiers actually present on the
# live Zuper job are emitted — this service never invents stock/SKUs.
MODULE_SKU_PREFIXES=0000675

# --- Downstream Grok bot routine webhooks (JSON POST) ---
# Shop Manager Bot routine URL (required for fan-out).
SHOP_MANAGER_WEBHOOK_URL=
# Parts Bot routine URL (optional; skipped if empty).
PARTS_BOT_WEBHOOK_URL=

# Optional shared token sent as X-Notify-Token on fan-out POSTs.
NOTIFY_TOKEN=

# Fan-out HTTP timeout in seconds.
NOTIFY_TIMEOUT_SECONDS=10

# Zuper GET /api/jobs/{job_uid} timeout in seconds.
ZUPER_TIMEOUT_SECONDS=20

# Flask / gunicorn
PORT=8080
